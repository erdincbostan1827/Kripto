ENVIRONMENT=DEV
MODE=PAPER
MARKET_TYPE=SPOT
DEFAULT_DISPLAY_SYMBOL=BTCUSDT
QUOTE_ASSETS=USDT,USDC
MAX_UNIVERSE_SIZE=50
MAX_DATA_LATENCY_SECONDS=10
MAX_CLOCK_DRIFT_SECONDS=2
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_SINGLE_ASSET_EXPOSURE=0.10
MAX_PORTFOLIO_EXPOSURE=0.50
MAX_OPEN_POSITIONS=8
MIN_RISK_REWARD=2.0
MAX_SPREAD_BPS=20
MIN_SIGNAL_SCORE=65
AUTO_EXECUTION=false
LIVE_TRADING_ENABLED=false
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
# Leave blank in Docker; container_entrypoint constructs a psycopg URL from POSTGRES_PASSWORD_FILE.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600
SESSION_INACTIVITY_SECONDS=900
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRITICAL_FALLBACK_WEBHOOK=
