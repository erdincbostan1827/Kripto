{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crypto Trading Platform",
  "version": "0.3.0",
  "identifier": "com.local.crypto-trading-platform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crypto Trading Platform",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
